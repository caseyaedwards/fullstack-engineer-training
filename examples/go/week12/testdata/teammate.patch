From ae78845e338ba299bdd27ee7fac45e5d534d6557 Mon Sep 17 00:00:00 2001
From: Sam Rivera <sam@example.com>
Date: Sun, 11 Oct 2026 07:40:24 +0000
Subject: [PATCH 1/4] api: send security headers with every answer

The OWASP REST Security Cheat Sheet asks an API to send
X-Content-Type-Options, X-Frame-Options and a frame-ancestors policy.
secureHeaders adds all three. TestSecureHeaders checks four routes,
including the JSON 404.
---
 internal/api/api.go          |  2 +-
 internal/api/headers.go      | 20 ++++++++++++++++++++
 internal/api/headers_test.go | 25 +++++++++++++++++++++++++
 3 files changed, 46 insertions(+), 1 deletion(-)
 create mode 100644 internal/api/headers.go
 create mode 100644 internal/api/headers_test.go

diff --git a/internal/api/api.go b/internal/api/api.go
index f68068c..3f4c787 100644
--- a/internal/api/api.go
+++ b/internal/api/api.go
@@ -57,3 +57,3 @@ func NewHandler(store monitor.Store, results monitor.ResultStore, incidents Inci
 	}
-	return sameOrigin(jsonFallback(mux))
+	return secureHeaders(sameOrigin(jsonFallback(mux)))
 }
diff --git a/internal/api/headers.go b/internal/api/headers.go
new file mode 100644
index 0000000..a3bd401
--- /dev/null
+++ b/internal/api/headers.go
@@ -0,0 +1,20 @@
+package api
+
+import "net/http"
+
+// secureHeaders adds the security headers that the OWASP REST Security
+// Cheat Sheet lists for an API to every answer:
+//   - X-Content-Type-Options: nosniff stops a browser from guessing a
+//     type other than the Content-Type the api sends.
+//   - X-Frame-Options: DENY and the frame-ancestors part of the
+//     Content-Security-Policy stop another site from showing an answer
+//     inside a frame of its own page.
+func secureHeaders(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		next.ServeHTTP(w, r)
+		h := w.Header()
+		h.Set("X-Content-Type-Options", "nosniff")
+		h.Set("X-Frame-Options", "DENY")
+		h.Set("Content-Security-Policy", "frame-ancestors 'none'")
+	})
+}
diff --git a/internal/api/headers_test.go b/internal/api/headers_test.go
new file mode 100644
index 0000000..048f128
--- /dev/null
+++ b/internal/api/headers_test.go
@@ -0,0 +1,25 @@
+package api
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+// TestSecureHeaders checks that every answer carries the security headers.
+func TestSecureHeaders(t *testing.T) {
+	h := newTestHandler(t)
+	for _, path := range []string{"/healthz", "/api/monitors", "/api/monitors/1", "/no-such-page"} {
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, path, nil))
+		for name, want := range map[string]string{
+			"X-Content-Type-Options":  "nosniff",
+			"X-Frame-Options":         "DENY",
+			"Content-Security-Policy": "frame-ancestors 'none'",
+		} {
+			if got := rec.Header().Get(name); got != want {
+				t.Errorf("GET %s: %s = %q, want %q", path, name, got, want)
+			}
+		}
+	}
+}
-- 
