From aeed5a124b894aea193ca7453901403de9c63dfa Mon Sep 17 00:00:00 2001
From: Sam Rivera <sam@example.com>
Date: Sun, 11 Oct 2026 07:40:49 +0000
Subject: [PATCH 3/4] worker: name the flag defaults

Collect the defaults of -timeout, -workers and -poll in one const
block at the top of main.go, where the next person finds them.
---
 cmd/worker/main.go | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/cmd/worker/main.go b/cmd/worker/main.go
index fb80c5c..a4d72ac 100644
--- a/cmd/worker/main.go
+++ b/cmd/worker/main.go
@@ -34,7 +34,14 @@ import (
 
+// The defaults of the command-line flags, in one place.
+const (
+	defaultTimeout = 5 * time.Second
+	defaultWorkers = 10
+	defaultPoll    = 1000 // one second
+)
+
 func main() {
 	databaseURL := flag.String("database-url", os.Getenv("DATABASE_URL"), "Postgres connection string; defaults to $DATABASE_URL")
-	timeout := flag.Duration("timeout", 5*time.Second, "how long to wait for each check")
-	workers := flag.Int("workers", 10, "how many checks run at the same time")
-	poll := flag.Duration("poll", time.Second, "how long a worker waits before it looks again when the queue is empty")
+	timeout := flag.Duration("timeout", defaultTimeout, "how long to wait for each check")
+	workers := flag.Int("workers", defaultWorkers, "how many checks run at the same time")
+	poll := flag.Duration("poll", defaultPoll, "how long a worker waits before it looks again when the queue is empty")
 	debugAddr := flag.String("debug-addr", "", "address for the pprof debug server, for example 127.0.0.1:6060; empty turns it off")
