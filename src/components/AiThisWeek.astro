---
// Standard week callout: the current AI-ladder stage, then this week's do and don't (the slot).
// The "## AI this week" heading stays in the page markdown and labels this aside by its Starlight id.
import { aiStages } from '../data/weeks';

const { aiStage } = Astro.locals.starlightRoute.entry.data;
if (aiStage === undefined) {
  throw new Error('<AiThisWeek> is for week pages: aiStage is required in the frontmatter.');
}
---

<aside class="callout callout-ai" aria-labelledby="ai-this-week">
  <p class="callout-stage">Stage {aiStage}: {aiStages[aiStage]}</p>
  <slot />
</aside>
