# Copy this file to .env, then change the password: cp .env.example .env
# Compose reads .env from this folder. .gitignore keeps .env out of Git.
# Use only letters and digits in the password: it goes into DATABASE_URL.
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
API_PORT=8080
WORKERS=10
# Where the alerter POSTs alerts as JSON. Empty: alerts go to its log.
# Treat a chat webhook URL as a password.
ALERT_WEBHOOK_URL=
